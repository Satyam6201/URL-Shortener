NODE_ENV=production
PORT=5000
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.rfou5mo.mongodb.net/urlshortener?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

JWT_SECRET=your-random-256-bit-jwt-secret-key-here
