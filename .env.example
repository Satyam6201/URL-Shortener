# Server & Network
NODE_ENV=production
PORT=5000
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Database & Caching
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.rfou5mo.mongodb.net/urlshortener?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

# Cryptographic Authentication Secrets
JWT_SECRET=your-random-256-bit-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration
GEMINI_API_KEY=your-gemini-api-key-here
AI_PROVIDER=gemini

# Rate Limiting & Quotas
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
DAILY_QUOTA_REGISTERED=100
DAILY_QUOTA_ANONYMOUS=5

# Redirection & Caching
REDIRECT_STATUS_CODE=302
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=60