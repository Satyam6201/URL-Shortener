DAILY_QUOTA_REGISTERED=100
DAILY_QUOTA_ANONYMOUS=5

REDIRECT_STATUS_CODE=302
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=60